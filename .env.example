# AWS Configuration (for Bedrock models - required)
# Configure via `aws configure` or set these variables:
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-west-2

# OpenAI Configuration (only required for "openai" provider models)
# Not needed when using Bedrock models only
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1  # Or https://openrouter.ai/api/v1 for OpenRouter
